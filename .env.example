# Environment Variables for FoodBridge Application
# Copy this file to .env and fill in your actual values

# API Configuration
REACT_APP_API_URL=http://localhost:3001/api
REACT_APP_APP_NAME=FoodBridge
REACT_APP_VERSION=1.0.0

# Firebase Configuration (if using Firebase)
REACT_APP_FIREBASE_API_KEY=AIzaSyBvHOoz0bKuhhseCJr43q59J8EJm2IrLPQ
REACT_APP_FIREBASE_AUTH_DOMAIN=miniprojcet-jsapp.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=miniprojcet-jsapp
REACT_APP_FIREBASE_STORAGE_BUCKET=miniprojcet-jsapp.firebasestorage.app
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=547266375620
REACT_APP_FIREBASE_APP_ID=1:547266375620:web:2cd1bc55f15cf44c6b3e9

# Google Maps API (for location services)
REACT_APP_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Email Service Configuration
REACT_APP_EMAIL_SERVICE_ID=your_email_service_id
REACT_APP_EMAIL_TEMPLATE_ID=your_email_template_id
REACT_APP_EMAIL_PUBLIC_KEY=your_email_public_key

# Analytics
REACT_APP_GOOGLE_ANALYTICS_ID=GA-XXXXXXXXX

# Feature Flags
REACT_APP_ENABLE_NOTIFICATIONS=true
REACT_APP_ENABLE_REAL_TIME_UPDATES=true
REACT_APP_ENABLE_GEOLOCATION=true
REACT_APP_ENABLE_IMAGE_UPLOAD=true

# Development Settings
REACT_APP_DEBUG_MODE=false
REACT_APP_LOG_LEVEL=info

# Third-party Services
REACT_APP_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_key
REACT_APP_TWILIO_ACCOUNT_SID=your_twilio_account_sid

# Social Media Links
REACT_APP_FACEBOOK_URL=https://facebook.com/foodbridge
REACT_APP_TWITTER_URL=https://twitter.com/foodbridge
REACT_APP_INSTAGRAM_URL=https://instagram.com/foodbridge

# Contact Information
REACT_APP_SUPPORT_EMAIL=support@foodbridge.com
REACT_APP_SUPPORT_PHONE=+1-555-FOODBRIDGE

# Legal
REACT_APP_PRIVACY_POLICY_URL=https://foodbridge.com/privacy
REACT_APP_TERMS_OF_SERVICE_URL=https://foodbridge.com/terms