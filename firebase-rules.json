{
  "rules": {
    "requests": {
      ".read": "auth != null",
      ".write": "auth != null",
      "userRequests": {
        "$userId": {
          ".read": "auth != null && auth.uid == $userId",
          ".write": "auth != null && auth.uid == $userId"
        }
      },
      "pendingRequests": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    }
  }
}
